# Port server
PORT=4000
# URL publik backend (dipakai untuk link gambar & halaman pembayaran simulasi)
PUBLIC_URL=http://localhost:4000

# Ganti dengan string acak yang panjang di produksi!
JWT_SECRET=ganti-dengan-rahasia-yang-panjang

# Akun admin awal (dibuat otomatis saat pertama kali dijalankan)
ADMIN_EMAIL=admin@harumgroup.id
ADMIN_PASSWORD=admin123

# Lokasi file database SQLite
DB_FILE=./data/harum.db

# ===== Payment Gateway =====
# PAYMENT_PROVIDER=simulator  -> mode demo/development (tanpa uang sungguhan)
# PAYMENT_PROVIDER=midtrans   -> QRIS, Virtual Account (transfer bank), GoPay/ShopeePay
PAYMENT_PROVIDER=simulator
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ===== Peta & ongkir per jarak =====
# Jarak tempuh dihitung lewat OSRM (OpenStreetMap, gratis). Untuk akurasi & kuota lebih
# besar isi API key Google Maps (aktifkan "Distance Matrix API").
GOOGLE_MAPS_API_KEY=
OSRM_URL=https://router.project-osrm.org
